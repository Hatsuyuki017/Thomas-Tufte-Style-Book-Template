% --------------------------------------------------------------------------
% Heading & header colour interface
% --------------------------------------------------------------------------
% \SetHeadingColorDepth{N} : the top N heading levels (chapter=1, section=2,
% subsection=3) keep their theme colour; deeper levels render in black.
% Default 3 = all three coloured.  Set 0 for fully black headings.
\def\book@headingcolordepth{3}
\newcommand{\SetHeadingColorDepth}[1]{\def\book@headingcolordepth{#1}}

% Per-slot colours (override via the public setters or \colorlet directly).
% NB: these colour names deliberately avoid the `@' character because
% \fancyhead and other expand-context macros tokenise their argument with
% `@' as \other, which makes xcolor's lookup of e.g. `book@headercolor' fail
% silently (the colour is "set" but the colorlet name cannot be resolved).
% Default palette mapping (top-down, darker -> lighter):
%   chapter    = oucpal6  (darkest, ink)
%   section    = oucpal5  (== primary)
%   subsection = oucpal4  (== secondary)
%   header     = oucpal6
% NB: bound by eager \colorlet -- \OUCSetPalette re-issues these so a
% palette switch in the preamble carries the headings along.  Users who
% want a custom slot must call \SetChapterColor / \SetSectionColor /
% \SetSubsectionColor / \SetHeaderColor AFTER any \OUCSetPalette call.
\colorlet{bookpartcolor}{oucpal6}
\colorlet{bookchaptercolor}{oucpal6}
\colorlet{booksectioncolor}{oucpal5}
\colorlet{booksubsectioncolor}{oucpal4}
\colorlet{bookheadercolor}{oucpal6}
\newcommand{\SetPartColor}[1]{\colorlet{bookpartcolor}{#1}}
\newcommand{\SetChapterColor}[1]{\colorlet{bookchaptercolor}{#1}}
\newcommand{\SetSectionColor}[1]{\colorlet{booksectioncolor}{#1}}
\newcommand{\SetSubsectionColor}[1]{\colorlet{booksubsectioncolor}{#1}}
\newcommand{\SetHeaderColor}[1]{\colorlet{bookheadercolor}{#1}}

% Unified theme-colour setters for every non-heading UI surface that
% participates in the palette.  Each shadows the palette default that
% \book@setpalettecolors installs on every \OUCSetPalette call -- so a
% setter call MUST appear after the palette switch to stick.
\newcommand{\SetKeywordColor}[1]{\colorlet{bookkeywordcolor}{#1}}
\newcommand{\SetCommentColor}[1]{\colorlet{bookcommentcolor}{#1}}
\newcommand{\SetStringColor}[1]{\colorlet{bookstringcolor}{#1}}
\newcommand{\SetLineNumColor}[1]{\colorlet{booklinenumcolor}{#1}}
\newcommand{\SetListingBackgroundColor}[1]{\colorlet{booklstbgcolor}{#1}}
\newcommand{\SetListingFrameColor}[1]{\colorlet{booklstframecolor}{#1}}
\newcommand{\SetTableHeadColor}[1]{\colorlet{booktableheadcolor}{#1}}
\newcommand{\SetTableHeadTextColor}[1]{\colorlet{booktableheadtextcolor}{#1}}
\newcommand{\SetTheoremTitleColor}[1]{\colorlet{booktheoremtitlecolor}{#1}}
\newcommand{\SetTheoremFillColor}[1]{\colorlet{booktheoremfillcolor}{#1}}
\newcommand{\SetTheoremTitleBarColor}[1]{\colorlet{booktheoremtitlebarcolor}{#1}}
\newcommand{\SetCaptionColor}[1]{\colorlet{bookcaptioncolor}{#1}}
\newcommand{\SetCaptionLabelColor}[1]{\colorlet{bookcaptionlabelcolor}{#1}}

% Depth-gated colour applicators (no-op when level deeper than configured
% depth, so the level renders in the surrounding black).
\newcommand{\book@applychaptercolor}{\ifnum\book@headingcolordepth>0 \color{bookchaptercolor}\fi}
\newcommand{\book@applysectioncolor}{\ifnum\book@headingcolordepth>1 \color{booksectioncolor}\fi}
\newcommand{\book@applysubsectioncolor}{\ifnum\book@headingcolordepth>2 \color{booksubsectioncolor}\fi}

% --------------------------------------------------------------------------
% Letter-spaced small-caps / all-caps
% --------------------------------------------------------------------------
% Tufte's \allcaps / \smallcaps default to soul's \sodef-based letterspacing,
% which in TeX Live 2025 conflicts with textcase's \MakeTextUppercase and
% crashes even upstream sample-book.tex.  We override at \AtBeginDocument
% with microtype's \textls (which is what upstream's own microtype branch
% in tufte-common.def lines 715-718 uses); if microtype is not loaded we
% fall back to identity (still gives \scshape small caps, just unspaced).
\AtBeginDocument{%
  \@ifpackageloaded{microtype}{%
    \def\allcapsspacing##1{\textls[200]{##1}}%
    \def\smallcapsspacing##1{\textls[50]{##1}}%
  }{%
    \let\allcapsspacing\@firstofone
    \let\smallcapsspacing\@firstofone
  }%
  \@ifundefined{sotextsc}{}{\let\sotextsc\@firstofone}%
}
% Re-wrap upstream \smallcaps / \allcaps so the \scshape they introduce is
% confined to an explicit group.  Upstream defines them as e.g.
%   \smallcaps#1 -> \smallcapsspacing{\scshape\MakeTextLowercase{#1}}
% When \smallcapsspacing collapses to \@firstofone (the xelatex-without-
% microtype fallback above), the braces around \scshape\MakeTextLowercase{#1}
% are consumed as the macro argument delimiter and \scshape leaks past
% \smallcaps, turning subsequent body text into small caps.  An outer
% {...} group on the redefinition fixes the leak and is a no-op on the
% microtype path.  Done outside \AtBeginDocument because \smallcaps /
% \allcaps are already defined by tufte-common.def before this sty loads.
\renewcommand{\allcaps}[1]{{\allcapsspacing{\MakeTextUppercase{#1}}}}
\renewcommand{\smallcaps}[1]{{\smallcapsspacing{\scshape\MakeTextLowercase{#1}}}}
\newcommand{\bookallcaps}[1]{\ifbook@chinese #1\else \MakeTextUppercase{#1}\fi}
\newcommand{\booksmallcaps}[1]{\ifbook@chinese #1\else {\scshape\MakeTextLowercase{#1}}\fi}

% ============================================================
% Font scheme switcher.
%   \SetBookFontScheme{tufte}  -> VDQI/Tufte default font chain
%       (Palatino Linotype / Helvetica Neue / Bera Mono), byte-identical to the
%       choices made by the A_Tufte_Style_Book_with_VDQI_Title_and_Contents_Page
%       sample (which inherits tufte-book defaults because bergamo.sty /
%       chantill.sty are kept commented out there).
%   \SetBookFontScheme{beamer} -> OUC-Haide-Beamer-Template font chain
%       (RobotoSerif main+sans, Menlo mono, and national-2-condensed-bold as
%       the display face bound to \ouctitledisplay), loaded from the local
%       ./fonts/ directory which is a verbatim copy of beamer/fonts.
% Math fonts are intentionally NOT set in either scheme: we keep the XeTeX +
% amsmath default (Latin Modern Math) so equations look identical across
% languages and font schemes, mirroring the VDQI sample which itself never
% calls \setmathfont / unicode-math / mathpazo.
% ============================================================
\providecommand{\book@fontscheme}{tufte}

\newcommand{\book@setlatinfonts@tufte}{%
  % Strict Tufte-book typography:
  %   Body  : Palatino / Pazo, loaded via [osf,sc]{mathpazo} at the top of
  %           this sty.  We DO NOT call \setmainfont here -- mathpazo binds
  %           \rmdefault to URW Palladio (ppl / pplj) through NFSS, giving
  %           Type 1 Palatino with real old-style figures and real small
  %           caps designed by URW.  Calling fontspec's \setmainfont would
  %           override that with a separate OpenType face (TeX Gyre Pagella)
  %           and break the visual match between text font and Pazo Math
  %           symbols, so we deliberately leave \rmdefault alone.
  %   Math  : Pazo Math, also from [osf,sc]{mathpazo}.
  %   Sans  : Gill Sans -> Helvetica Neue -> Bera Sans -> Arial, Scale=0.86
  %           to optically match the Palatino x-height (Tufte spec).  These
  %           are set via fontspec because mathpazo does not touch sans.
  %   Mono  : Bera Mono -> Source Code Pro -> Latin Modern Mono -> Courier
  %           New, Scale=0.86.  Likewise set via fontspec.
  \renewcommand{\ouctitledisplay}{}%
  \IfFontExistsTF{Gill Sans}{%
    \setsansfont[Scale=0.86]{Gill Sans}%
  }{%
    \IfFontExistsTF{Helvetica Neue}{%
      \setsansfont[Scale=0.86]{Helvetica Neue}%
    }{%
      \IfFontExistsTF{Bera Sans}{%
        \setsansfont[Scale=0.86]{Bera Sans}%
      }{%
        \IfFontExistsTF{TeX Gyre Heros}{%
          \setsansfont[Renderer=Basic, Scale=0.86]{TeX Gyre Heros}%
        }{%
          \setsansfont[Scale=0.86]{Arial}}}}%
  }%
  \IfFontExistsTF{Bera Mono}{%
    \setmonofont[Scale=0.86]{Bera Mono}%
  }{%
    \IfFontExistsTF{Source Code Pro}{%
      \setmonofont[Scale=0.86]{Source Code Pro}%
    }{%
      \IfFontExistsTF{Latin Modern Mono}{%
        \setmonofont[Scale=0.86]{Latin Modern Mono}%
      }{%
        \IfFontExistsTF{TeX Gyre Cursor}{%
          \setmonofont[Renderer=Basic, Scale=0.86]{TeX Gyre Cursor}%
        }{%
          \setmonofont[Scale=0.86]{Courier New}}}}%
  }%
}

\newcommand{\book@setlatinfonts@beamer}{%
  \setmainfont{RobotoSerif-Regular.ttf}[Path={fonts/},
    ItalicFont=RobotoSerif-Italic.ttf]%
  \setsansfont{RobotoSerif-Regular.ttf}[Path={fonts/},
    ItalicFont=RobotoSerif-Italic.ttf]%
  \IfFontExistsTF{Menlo}{\setmonofont{Menlo}}{%
    \IfFontExistsTF{Source Code Pro}{\setmonofont{Source Code Pro}}{%
      \IfFontExistsTF{Bera Mono}{\setmonofont{Bera Mono}}{%
        \setmonofont{Courier New}}}}%
  \@ifundefined{book@nationalfont}{%
    \newfontface\book@nationalfont{national-2-condensed-bold.ttf}[Path={fonts/}]%
  }{}%
  \renewcommand{\ouctitledisplay}{\book@nationalfont}%
}

\newcommand{\book@setlatinfonts}{%
  \ifdefstring{\book@fontscheme}{beamer}{%
    \book@setlatinfonts@beamer
  }{%
    \book@setlatinfonts@tufte
  }%
}

\newcommand{\SetBookFontScheme}[1]{%
  \renewcommand{\book@fontscheme}{#1}%
