% fontenc[T1] BEFORE mathpazo so that mathpazo's NFSS hooks for the
% URW Palladio (ppl / pplj) Type 1 text shapes -- which are only declared
% for T1/OT1 encoding -- become reachable.  Without this, fontspec leaves
% \encodingdefault at TU and TU/pplj/m/n is undefined, silently falling
% back to Latin Modern even though mathpazo set \rmdefault=pplj.  Under
% XeLaTeX, loading [T1]{fontenc} after fontspec switches \encodingdefault
% to T1 for legacy NFSS text while fontspec's TU remains available for
% \setsansfont / \setmonofont / xeCJK families set later.
\RequirePackage[T1]{fontenc}
% Pazo Math + Palatino / Pazo text family (URW Palladio) from psnfss.
% [osf]  -> old-style figures (pplj),  [sc] -> real small caps NFSS shapes.
