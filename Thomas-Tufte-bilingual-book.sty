    #1
}

%% Inline helpers (byte-identical to beamer).
\newcommand{\UnderlineBox}[1]{%
    \begin{tcolorbox}[colback=white,colframe=white,right=10mm,top=0mm,left=2.5mm]
    {#1}\\[-5pt]
    \tikz{\draw (0,0)--(\linewidth-1cm,0); \draw (0,.05)--(\linewidth-1cm,.05);}
    \end{tcolorbox}}
\newcommand{\Quote}[2]{\epigraph{\textit{#1}}{#2}}
\newcommand{\Minipage}[4]{\noindent%
    \begin{minipage}[t][][b]{#1\textwidth}{#2}\end{minipage}\hfill
    \begin{minipage}[t][][b]{#3\textwidth}{#4}\end{minipage}\noindent}
\BeforeBeginEnvironment{wrapfigure}{\setlength{\intextsep}{2pt}}
\newcommand{\EvOdd}[3]{%
    \noindent\begin{wrapfigure}[#1]{r}{#2}#3\end{wrapfigure}}
\providecommand{\Eq}[1]{\begin{align*}#1\end{align*}}
\providecommand{\EqL}[2]{\begin{align}\label{#2}#1\end{align}}

% \textkai{...} : local Kai-style Chinese rendering. We swap implementation via
% \let at \AtBeginDocument time (avoids #-doubling pitfalls of \renewcommand
% inside hook tokens).
\newcommand{\book@textkai@plain}[1]{{#1}}
\newcommand{\book@textkai@withfont}[1]{{\CJKfamily{bookkai}#1}}
\let\textkai\book@textkai@plain
\AtBeginDocument{%
  \@ifundefined{book@hasKai}{}{%
    \ifnum\book@hasKai=1\relax
      \let\textkai\book@textkai@withfont
    \fi%
  }%
}

\makeatletter
% Apply the depth-gated chapter colour to \@makechapterhead /
% \@makeschapterhead too, so \chapter* and any non-titlesec code path still
% honours \SetHeadingColorDepth / \SetChapterColor.
\pretocmd{\@makechapterhead}{\book@applychaptercolor}{}{}
\pretocmd{\@makeschapterhead}{\book@applychaptercolor}{}{}
% Tufte's \allcaps wraps \MakeTextUppercase inside soul's \sodef-letterspaced
% \allcapsspacing macro.  In TeX Live 2025 this combination breaks (textcase's
% \MakeTextUppercase rejects soul's tokenised argument with "extra }"); this
% even bites upstream's own sample-book.tex.  Define a soul-free fallback used
% inside \maketitlepage; outside the title page \allcaps continues to work
% for short literal strings (sidenote epigraphs etc).
\newcommand{\book@plainallcaps}[1]{\MakeTextUppercase{#1}}

\renewcommand{\maketitlepage}{%
  % Structure follows tufte-latex-master/tufte-common.def's \maketitlepage:
  % sffamily, fullwidth, three blocks at 18/20, 36/40, 14/16.  We use
  % \book@plainallcaps (no soul letterspacing) to dodge the textcase/soul
  % incompatibility documented above.  Colors swap upstream's darkgray for
  % OUC palette slots.  In Chinese mode we skip the uppercase pass entirely
  % so CJK glyphs render unchanged.
  \cleardoublepage%
  {%
    \sffamily%
    \begin{fullwidth}%
      \fontsize{18}{20}\selectfont\par\noindent
      \textcolor{primary}{\ifbook@chinese\thanklessauthor\else\book@plainallcaps{\thanklessauthor}\fi}%
      \vspace{11.5pc}%
      \fontsize{36}{40}\selectfont\par\noindent
      \textcolor{oucpal6}{\ifbook@chinese\thanklesstitle\else\book@plainallcaps{\thanklesstitle}\fi}%
      \vfill%
      \fontsize{14}{16}\selectfont\par\noindent
      \textcolor{primary}{\ifbook@chinese\thanklesspublisher\else\book@plainallcaps{\thanklesspublisher}\fi}%
    \end{fullwidth}%
  }%
  \thispagestyle{empty}%
  \clearpage%
}
\newcommand{\book@parttoclabel}{\textcolor{primary}{\ifbook@chinese 第~\thecontentslabel~部分\else \bookallcaps{Part~\thecontentslabel}\fi}}
\newcommand{\book@chaptertocwithlabel}{\ifbook@chinese \textcolor{primary}{第~\thecontentslabel~章}\quad\else \textcolor{primary}{\contentslabel{2em}}\fi}
\newcommand{\book@chaptertocnolabel}{\hspace{0em}}

\titlecontents{part}%
    [0pt]%
  {\addvspace{0.25\baselineskip}\color{oucpal6}}%
    {\book@parttoclabel}%
    {\book@parttoclabel}%
  {\hfill\color{primary}\thecontentspage}%
    [\vspace*{0.5\baselineskip}]%

\titlecontents{chapter}%
    [4em]%
  {\color{oucpal6}}%
    {\book@chaptertocwithlabel}%
    {\book@chaptertocnolabel}%
  {\qquad\color{primary}\thecontentspage}%
    [\vspace*{0.5\baselineskip}]%

% Restore tufte-latex-master's chapter / section / subsection font spec
% (\huge\rmfamily\itshape, \Large\itshape, \large\itshape).  Colours go
% through the depth-gated applicators so users can dial back via
% \SetHeadingColorDepth{N}.  We use \titleformat directly instead of
% sectsty's \sectionfont, because the latter REPLACES the default font
% selection and silently drops tufte's \itshape, which gave us the
% bold-upright chapter heads we originally complained about.
\titleformat{\part}%
  [display]
  {\centering\color{bookpartcolor}\normalfont\huge\itshape}% format applied to label+text
  {\partname\ \thepart}% label
  {1em}% horizontal separation
  {\Huge\rmfamily\itshape}% before title body
\titleformat{\chapter}%
  [display]
  {\relax}% format applied to label+text
  {\book@applychaptercolor\itshape\huge\thechapter}% label
  {0pt}% horizontal separation
  {\book@applychaptercolor\huge\rmfamily\itshape}% before title body
\titleformat{\section}%
  [hang]
  {\normalfont\Large\itshape\book@applysectioncolor}%
  {\thesection}%
  {1em}%
  {}
\titleformat{\subsection}%
  [hang]
  {\normalfont\large\itshape\book@applysubsectioncolor}%
  {\thesubsection}%
  {1em}%
  {}

% Override tufte-book.cls's headers to honour \SetHeaderColor.  Structure
% mirrors tufte-book.cls lines 51-58 (book title on verso, chapter title on
% recto) but wraps each in \textcolor{bookheadercolor} so headers can be
% retinted independently of heading colours.  \smallcaps now renders as
% true letter-spaced small caps because our \smallcapsspacing override
% above routes through microtype's \textls.
%
% Two complications:
%   (1) tufte-book.cls's \mainmatter calls \fancyhf{} + \fancyhead[...]
%       directly, which clobbers the CURRENT pagestyle's heads -- not a
%       named pagestyle, so we can't shield ourselves with \fancypagestyle.
%       We patch \mainmatter at \AtBeginDocument so the colour-aware heads
%       are reapplied after its body runs.
%   (2) Likewise for \frontmatter (which sets a bare \fancyhead[..]{\thepage}).
\renewcommand{\chaptermark}[1]{\markboth{#1}{}}
\newcommand{\book@apply@headers}{%
  \fancyhf{}%
  \fancyhead[LE]{\rmfamily\textcolor{bookheadercolor}{\thepage\quad\smallcaps{\newlinetospace{\plaintitle}}}}%
  \fancyhead[RO]{\rmfamily\textcolor{bookheadercolor}{\smallcaps{\newlinetospace{\leftmark}}\quad\thepage}}%
}
\AtBeginDocument{%
  \book@apply@headers%
  \@ifundefined{mainmatter}{}{%
    \let\book@orig@mainmatter\mainmatter%
    \def\mainmatter{\book@orig@mainmatter\book@apply@headers}%
  }%
}

%% Captions (including margin figures / tables under tufte-book) route
%% through bookcaptioncolor and bookcaptionlabelcolor so \OUCSetPalette
%% switches them and \SetCaptionColor / \SetCaptionLabelColor override.
\setcaptionfont{\color{bookcaptioncolor}}
\renewcommand{\fnum@figure}{\textcolor{bookcaptionlabelcolor}{\figurename~\thefigure}}
\renewcommand{\fnum@table}{\textcolor{bookcaptionlabelcolor}{\tablename~\thetable}}
\makeatother