\newcommand{\book@setpalettecolors}[7]{%
  \definecolor{oucpal1}{RGB}{#2}%
  \definecolor{oucpal2}{RGB}{#3}%
  \definecolor{oucpal3}{RGB}{#4}%
  \definecolor{oucpal4}{RGB}{#5}%
  \definecolor{oucpal5}{RGB}{#6}%
  \definecolor{oucpal6}{RGB}{#7}%
  %% Semantic palette aliases — kept byte-identical to the beamer template:
  %%   primary   = pal5 (second darkest, main emphasis)
  %%   secondary = pal4 (mid-dark; theorem/example title backgrounds)
  %%   accent    = pal3 (mid; legacy emphasis used by some helpers)
  %%   softblue  = pal2 (light body fill for Example/Remark/Intro)
  %%   paleblue  = pal1 (lightest, listing background)
  \colorlet{paleblue}{oucpal1}%
  \colorlet{softblue}{oucpal2}%
  \colorlet{accent}{oucpal3}%
  \colorlet{secondary}{oucpal4}%
  \colorlet{primary}{oucpal5}%
  \colorlet{spotcolor}{oucpal6}%
  %% Private color names consumed by the lstlisting style.
  \colorlet{lstfg}{inkdark}%
  \colorlet{lstbg}{oucpal1}%
  \colorlet{lstaccent}{oucpal6}%
  \colorlet{lstborder}{oucpal6}%
  \definecolor{linegray}{RGB}{226,232,240}%
  %% Rebind heading colours to the active palette (pal6/pal5/pal4 chain).
  %% Unconditional -- xcolor stores colorlets as \color@<name>, so guarding
  %% with \@ifundefined{<name>} would always succeed (the macro \<name>
  %% itself is never defined) and the rebind would be skipped.  Any user
  %% override via \SetChapterColor / \SetSectionColor / \SetSubsectionColor
  %% / \SetHeaderColor must therefore be RE-APPLIED after each
  %% \OUCSetPalette call because this block resets them to the new palette.
  \colorlet{bookpartcolor}{oucpal6}%
  \colorlet{bookchaptercolor}{oucpal6}%
  \colorlet{booksectioncolor}{oucpal5}%
  \colorlet{booksubsectioncolor}{oucpal4}%
  \colorlet{bookheadercolor}{oucpal6}%
  %% Same idea, extended to every secondary UI surface that should track
  %% the palette: code listings, table heads, theorem title bars, and
  %% figure/table captions.  Each slot has a matching \SetXxxColor public
  %% setter (defined just after the heading-colour setters); users who
  %% override must call the setter AFTER \OUCSetPalette because this block
  %% re-establishes the palette defaults on every palette switch.
  \colorlet{bookkeywordcolor}{oucpal5}%       lstlisting keywords
  \colorlet{bookcommentcolor}{oucpal4}%       lstlisting comments
  \colorlet{bookstringcolor}{hiP}%            lstlisting strings (kept warm-red for legibility across palettes)
  \colorlet{booklinenumcolor}{oucpal5}%       lstlisting line numbers
  \colorlet{booklstbgcolor}{oucpal1}%         lstlisting background fill
  \colorlet{booklstframecolor}{linegray}%     lstlisting frame rule
  \colorlet{booktableheadcolor}{oucpal5}%     \booktableheadrow row fill
  \colorlet{booktableheadtextcolor}{white}%   \booktableheadcell text colour
  \colorlet{booktheoremtitlecolor}{oucpal5}%  theorem env title text (Pro/Le/Co/De/The/Proof)
  \colorlet{booktheoremfillcolor}{oucpal2}%   Exa/Rmk theorem body fill
  \colorlet{booktheoremtitlebarcolor}{oucpal4}% Exa/Rmk boxed-title fill
  \colorlet{bookcaptioncolor}{oucpal5}%       caption body text (incl. margin figures)
  \colorlet{bookcaptionlabelcolor}{oucpal6}%  "Figure N" / "Table N" label
  \renewcommand{\OUCPaletteName}{#1}%
  \renewcommand{\OUCSpotColorName}{Accent}%
}

\newcommand{\book@setspotcolor}[4]{%
  \definecolor{spotcolor}{RGB}{#1,#2,#3}%
  \renewcommand{\OUCSpotColorName}{#4}%
}

\newcommand{\booktableheadrow}{\rowcolor{booktableheadcolor}}
\newcommand{\booktableheadcell}[1]{\textcolor{booktableheadtextcolor}{\bfseries #1}}

%% lstlisting style now references the bookXxxcolor colorlets instead of
%% raw palette / hard-coded colour names, so \OUCSetPalette propagates and
%% \SetKeywordColor / \SetCommentColor / \SetStringColor / \SetLineNumColor
%% / \SetListingBackgroundColor / \SetListingFrameColor can override.
\lstdefinestyle{oucbooklisting}{%
  backgroundcolor=\color{booklstbgcolor},%
  basicstyle=\ttfamily\small,%
  commentstyle=\itshape\color{bookcommentcolor},%
  keywordstyle=\bfseries\color{bookkeywordcolor},%
  stringstyle=\color{bookstringcolor},%
  identifierstyle=\color{black},%
  numberstyle=\scriptsize\color{booklinenumcolor},%
  numbers=left,%
  numbersep=0.8em,%
  frame=single,%
  rulecolor=\color{booklstframecolor},%
  framerule=0.5pt,%
  xleftmargin=1.25em,%
  framexleftmargin=0.9em,%
  framesep=0.6em,%
  aboveskip=1.0\baselineskip,%
  belowskip=1.0\baselineskip,%
  breaklines=true,%
  breakatwhitespace=false,%
  showstringspaces=false,%
  keepspaces=true,%
  columns=fullflexible,%
  upquote=true,%
  tabsize=4,%
  captionpos=b%
}

\lstset{style=oucbooklisting}

\newcommand{\bookpaletteswatch}[1]{%
  {\color{#1}\rule[-0.3ex]{2.6em}{2.4ex}}%
}

\newcommand{\bookpaletteguideentry}[8]{%
  \definecolor{bookguideA}{RGB}{#3}%
  \definecolor{bookguideB}{RGB}{#4}%
  \definecolor{bookguideC}{RGB}{#5}%
  \definecolor{bookguideD}{RGB}{#6}%
  \definecolor{bookguideE}{RGB}{#7}%
  \definecolor{bookguideF}{RGB}{#8}%
  \noindent\textbf{#1}\enspace #2\par
  \bookpaletteswatch{bookguideA}\hspace{0.35em}%
  \bookpaletteswatch{bookguideB}\hspace{0.35em}%
  \bookpaletteswatch{bookguideC}\hspace{0.35em}%
  \bookpaletteswatch{bookguideD}\hspace{0.35em}%
  \bookpaletteswatch{bookguideE}\hspace{0.35em}%
  \bookpaletteswatch{bookguideF}\par\medskip
}

% Helpers for the Palette Introduction chapter.
% \bookcardswatch{R,G,B} renders a 2.2em x 2ex coloured cell suitable for a
% palette-card table.  The color is defined locally inside a group so the
% temporary name does not leak across rows.
\newcommand{\bookcardswatch}[1]{%
  \begingroup
  \definecolor{bookcardtmp}{RGB}{#1}%
  {\color{bookcardtmp}\rule[-0.4ex]{2.2em}{2.0ex}}%
  \endgroup
}
% \bookpalettecardhead{title} opens an unnumbered section that is still
% recorded in the table of contents.
\newcommand{\bookpalettecardhead}[1]{%
  \section*{#1}%
  \addcontentsline{toc}{section}{#1}%
}
% Fallback Unicode font for Greek / Cyrillic glyphs that mathpazo lacks.
\IfFontExistsTF{Times New Roman}{%
  \newfontfamily\bookforeignfont{Times New Roman}%
}{%
  \IfFontExistsTF{DejaVu Serif}{%
    \newfontfamily\bookforeignfont{DejaVu Serif}%
  }{%
    \newfontfamily\bookforeignfont{TeX Gyre Termes}%
  }%
}
\DeclareRobustCommand{\foreignname}[1]{{\bookforeignfont #1}}

% \palettesubsec{title} prints an italic small-caps subsection label that
% sits between paragraphs without polluting the table of contents.
\newcommand{\palettesubsec}[1]{%
  \par\medskip\noindent
  {\normalfont\itshape\bfseries #1}\par\nopagebreak\smallskip
}
% \palettebullets ... \endpalettebullets : compact bulleted list for the
% per-colour annotations under each palette card.
\newenvironment{palettebullets}{%
  \begin{list}{\textbullet}{%
    \setlength{\leftmargin}{1.4em}%
    \setlength{\labelsep}{0.5em}%
    \setlength{\topsep}{0pt}%
    \setlength{\itemsep}{1pt}%
    \setlength{\parsep}{1pt}%
  }%
}{%
  \end{list}%
}

