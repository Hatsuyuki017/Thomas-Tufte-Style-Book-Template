\newcommand{\book@setcjkfonts}{%
  % Main CJK serif: prefer Songti SC (full Unicode CJK coverage; matches beamer template
  % and fixes missing-character glyphs caused by partial KaiTi italic mapping).
  % Use AutoFakeSlant for italic shape instead of the incomplete KaiTi italic font.
  \IfFontExistsTF{Songti SC}{%
    \setCJKmainfont[AutoFakeBold=2,AutoFakeSlant=0.2]{Songti SC}%
  }{%
    \IfFontExistsTF{Source Han Serif SC}{%
      \setCJKmainfont[AutoFakeBold=2,AutoFakeSlant=0.2]{Source Han Serif SC}%
    }{%
      \IfFontExistsTF{Noto Serif CJK SC}{%
        \setCJKmainfont[AutoFakeBold=2,AutoFakeSlant=0.2]{Noto Serif CJK SC}%
      }{%
        \IfFontExistsTF{SimSun}{%
          \setCJKmainfont[AutoFakeBold=2,AutoFakeSlant=0.2]{SimSun}%
        }{%
          \setCJKmainfont[AutoFakeBold=2,AutoFakeSlant=0.2]{FandolSong-Regular}%
        }%
      }%
    }%
  }%
  \IfFontExistsTF{Source Han Sans SC}{%
    \setCJKsansfont[AutoFakeBold=2]{Source Han Sans SC}%
  }{%
    \IfFontExistsTF{Noto Sans CJK SC}{%
      \setCJKsansfont[AutoFakeBold=2]{Noto Sans CJK SC}%
    }{%
      \IfFontExistsTF{PingFang SC}{%
        \setCJKsansfont[AutoFakeBold=2]{PingFang SC}%
      }{%
        \IfFontExistsTF{Microsoft YaHei}{%
          \setCJKsansfont[AutoFakeBold=2]{Microsoft YaHei}%
        }{%
          \IfFontExistsTF{SimHei}{%
            \setCJKsansfont[AutoFakeBold=2]{SimHei}%
          }{%
            \setCJKsansfont[AutoFakeBold=2]{FandolHei-Regular}%
          }%
        }%
      }%
    }%
  }%
  \IfFontExistsTF{STFangsong}{%
    \setCJKmonofont{STFangsong}%
  }{%
    \IfFontExistsTF{FangSong}{%
      \setCJKmonofont{FangSong}%
    }{%
      \IfFontExistsTF{FandolFang-Regular}{%
        \setCJKmonofont{FandolFang-Regular}%
      }{%
        \setCJKmonofont{Courier New}%
      }%
    }%
  }%
  % Local Kai family used by \textkai{...}. Try KaiTi -> STKaiti -> FandolKai.
  \IfFontExistsTF{KaiTi}{%
    \setCJKfamilyfont{bookkai}{KaiTi}%
    \def\book@hasKai{1}%
  }{%
    \IfFontExistsTF{STKaiti}{%
      \setCJKfamilyfont{bookkai}{STKaiti}%
      \def\book@hasKai{1}%
    }{%
      \IfFontExistsTF{Kaiti SC}{%
        \setCJKfamilyfont{bookkai}{Kaiti SC}%
        \def\book@hasKai{1}%
      }{%
        \IfFontExistsTF{FandolKai-Regular}{%
          \setCJKfamilyfont{bookkai}{FandolKai-Regular}%
          \def\book@hasKai{1}%
        }{%
          \def\book@hasKai{0}%
        }%
      }%
    }%
  }%
}

