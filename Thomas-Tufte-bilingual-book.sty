% ============================================================
% Beamer-parity theorem-like environments (tcolorbox-based).
% Definitions below are byte-identical copies from the companion
% oucsmartbeamer.sty so that book and beamer share the same visual
% language. Only differences:
%   - The names are taken from \book...name macros (which switch
%     between English and Chinese based on \ifbook@chinese).
%   - The first environment is anchored on a chapter-resetting
%     counter via [number within=chapter] (beamer numbers within
%     the deck, books number within chapters).
% Palette slot semantics (matching beamer exactly):
%   pal1=paleblue=lstlisting bg;  pal2=softblue=Exa/Rmk/Intro body;
%   pal4=secondary=Exa/Rmk/Intro title fill;  pal5=primary=emphasis;
%   pal3=accent;  pal6=darkest swatch.
% ============================================================
%% Every tcbtheorem definition now references bookXxxcolor colorlets in
%% place of raw `primary` / `oucpal2` / `oucpal4`.  tcolorbox resolves
%% these at render time so palette switches AND \SetTheoremTitleColor /
%% \SetTheoremFillColor / \SetTheoremTitleBarColor overrides both work.
\newtcbtheorem[number within=chapter]{The}{\booktheoremname}{%
    colback=white,fonttitle=\ouctitledisplay\bfseries\color{booktheoremtitlecolor},breakable,enhanced jigsaw,
    boxrule=0pt,left=4mm,right=2mm,top=3.5mm,bottom=0mm,
    attach boxed title to top left={yshift=-2.5mm, xshift=2.5mm},
    boxed title style={colback=white!50,colframe=white},
    before=\vspace{\baselineskip}}{the}
\newtcbtheorem[use counter from=The]{Exa}{\bookexamplename}{%
    colback=booktheoremfillcolor,fonttitle=\ouctitledisplay\bfseries\color{booktheoremtitlecolor},breakable,enhanced jigsaw,
    boxrule=0pt,left=4mm,right=2mm,top=3.5mm,bottom=0mm,
    attach boxed title to top left={yshift=-2.5mm, xshift=1mm},
    boxed title style={colback=booktheoremtitlebarcolor,colframe=booktheoremtitlebarcolor,left=-0.025cm,right=.025cm,bottom=.025cm},
    before=\vspace{\baselineskip}}{exa}
\newtcbtheorem[use counter from=The]{Rmk}{\bookremarkname}{%
    colback=booktheoremfillcolor,fonttitle=\ouctitledisplay\bfseries\color{booktheoremtitlecolor},breakable,enhanced jigsaw,
    boxrule=0pt,left=4mm,right=2mm,top=3.5mm,bottom=0mm,
    attach boxed title to top left={yshift=-2.5mm, xshift=2.5mm},
    boxed title style={colback=booktheoremtitlebarcolor,colframe=booktheoremtitlebarcolor,left=-0.025cm,right=.025cm,bottom=.025cm},
    before=\vspace{\baselineskip}}{rmk}
\newtcbtheorem[use counter from=The]{Pro}{\bookpropositionname}{%
    colback=white,fonttitle=\ouctitledisplay\bfseries\color{booktheoremtitlecolor},breakable,enhanced jigsaw,
    boxrule=0pt,left=4mm,right=2mm,top=3.5mm,bottom=0mm,
    attach boxed title to top left={yshift=-2.5mm, xshift=2.5mm},
    boxed title style={colback=white!50,colframe=white},
    before=\vspace{\baselineskip}}{pro}
\newtcbtheorem[use counter from=The]{Le}{\booklemmaname}{%
    colback=white,fonttitle=\ouctitledisplay\bfseries\color{booktheoremtitlecolor},breakable,enhanced jigsaw,
    boxrule=0pt,left=4mm,right=2mm,top=3.5mm,bottom=0mm,
    attach boxed title to top left={yshift=-2.5mm, xshift=2.5mm},
    boxed title style={colback=white!50,colframe=white},
    before=\vspace{\baselineskip}}{le}
\newtcbtheorem[use counter from=The]{Co}{\bookcorollaryname}{%
    colback=white,fonttitle=\ouctitledisplay\bfseries\color{booktheoremtitlecolor},breakable,enhanced jigsaw,
    boxrule=0pt,left=4mm,right=2mm,top=3.5mm,bottom=0mm,
    attach boxed title to top left={yshift=-2.5mm, xshift=2.5mm},
    boxed title style={colback=white!50,colframe=white},
    before=\vspace{\baselineskip}}{co}
\newtcbtheorem[use counter from=The]{De}{\bookdefinitionname}{%
    colback=white,fonttitle=\ouctitledisplay\bfseries\color{booktheoremtitlecolor},breakable,enhanced jigsaw,
    boxrule=0pt,left=4mm,right=2mm,top=3.5mm,bottom=0mm,
    attach boxed title to top left={yshift=-2.5mm, xshift=2.5mm},
    boxed title style={colback=white!50,colframe=white},
    before=\vspace{\baselineskip}}{de}

%% Proof: hand-written inline form (matches beamer byte-for-byte).
%%   headfont = \ouctitledisplay\bfseries
%%   postheadspace = .5cm   qed = $\square$
\providecommand{\OUCQEDsymbol}{\ensuremath{\square}}
\newenvironment{OUCProof}{%
